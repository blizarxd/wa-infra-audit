# ── WA Infra Audit ──────────────────────────────────────────────
# Meta (Facebook) Graph API access token.
# Recommended: a System User token with these permissions:
#   whatsapp_business_management, business_management
# You can also paste the token directly in the dashboard instead.
META_ACCESS_TOKEN=

# Optional — Graph API version (default: v21.0)
GRAPH_VERSION=

# Optional — server port (default: 3900)
PORT=
